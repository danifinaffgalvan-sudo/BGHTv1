<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="20dp"
    android:clipChildren="false" android:clipToPadding="false">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/logo_bgh"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BGH Tv"
            android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"
            android:layout_marginStart="12dp" android:layout_marginEnd="40dp"/>
        <TextView android:id="@+id/tabHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inicio"
            android:textSize="20sp" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:textColor="@color/tab_text" android:background="@drawable/tab_bg" android:focusable="true" android:clickable="true"/>
        <TextView android:id="@+id/tabApps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apps"
            android:textSize="20sp" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:textColor="@color/tab_text" android:background="@drawable/tab_bg" android:focusable="true" android:clickable="true"/>
        <TextView android:id="@+id/tabLib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Biblioteca"
            android:textSize="20sp" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:textColor="@color/tab_text" android:background="@drawable/tab_bg" android:focusable="true" android:clickable="true"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/btnTheme" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fondo"
            android:textSize="18sp" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:textColor="@color/tab_text" android:background="@drawable/tab_bg" android:focusable="true" android:clickable="true"/>
        <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="24dp" android:textColor="#D5DBE6" android:textSize="22sp"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipChildren="false" android:clipToPadding="false">

        <ScrollView android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipChildren="false" android:clipToPadding="false" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:clipChildren="false" android:paddingBottom="32dp">

                <LinearLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="220dp"
                    android:layout_marginTop="20dp" android:layout_marginBottom="16dp" android:padding="24dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:focusable="true" android:clickable="true" android:background="@drawable/hero_bg">
                    <ImageView android:id="@+id/heroImg" android:layout_width="300dp" android:layout_height="169dp" android:scaleType="fitCenter"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:layout_marginStart="32dp">
                        <TextView android:id="@+id/heroGreeting" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#C5CCD8" android:textSize="20sp"/>
                        <TextView android:id="@+id/heroTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" android:maxLines="2"/>
                        <TextView android:id="@+id/heroSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#AEB8C8" android:textSize="18sp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★ Favoritos"
                    android:textColor="#FFFFFF" android:textSize="20sp" android:layout_marginStart="6dp"/>
                <TextView android:id="@+id/favHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Mantené apretado OK sobre una app para agregarla acá."
                    android:textColor="#AEB8C8" android:textSize="16sp" android:layout_margin="12dp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rowFavs"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:clipChildren="false" android:clipToPadding="false" android:descendantFocusability="afterDescendants"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tus apps"
                    android:textColor="#FFFFFF" android:textSize="20sp" android:layout_marginTop="12dp" android:layout_marginStart="6dp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rowApps"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:clipChildren="false" android:clipToPadding="false" android:descendantFocusability="afterDescendants"/>
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:id="@+id/pageApps" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:visibility="gone" android:paddingTop="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Todas las apps"
                android:textColor="#FFFFFF" android:textSize="22sp" android:layout_marginStart="6dp"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/gridApps"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false" android:paddingTop="8dp" android:descendantFocusability="afterDescendants"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/pageLib" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:visibility="gone" android:paddingTop="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Biblioteca · Ajustes del TV"
                android:textColor="#FFFFFF" android:textSize="22sp" android:layout_marginStart="6dp"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/gridLib"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false" android:paddingTop="8dp" android:descendantFocusability="afterDescendants"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
